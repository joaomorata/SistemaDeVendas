@{
    ViewData["Title"] = "Início";
}

<div class="container my-4">
    <div class="mb-4 pb-3 border-bottom">
        <h1 class="h2 text-primary fw-bold mb-1">
            <i class="bi bi-truck me-2"></i>Painel de Rotas
        </h1>
        <p class="text-muted small mb-0">Cadastre clientes, registre pacotes e monte a melhor rota de coleta.</p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body text-center">
                    <i class="bi bi-people-fill fs-2 text-primary"></i>
                    <div class="fs-3 fw-bold">@ViewBag.TotalClientes</div>
                    <div class="text-muted small">Clientes</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body text-center">
                    <i class="bi bi-box-seam-fill fs-2 text-warning"></i>
                    <div class="fs-3 fw-bold">@ViewBag.PacotesPendentes</div>
                    <div class="text-muted small">Pacotes pendentes</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body text-center">
                    <i class="bi bi-signpost-split-fill fs-2 text-success"></i>
                    <div class="fs-3 fw-bold">@ViewBag.RotasAbertas</div>
                    <div class="text-muted small">Rotas em aberto</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body text-center">
                    <i class="bi bi-cart-check-fill fs-2 text-secondary"></i>
                    <div class="fs-3 fw-bold">@ViewBag.TotalVendas</div>
                    <div class="text-muted small">Vendas</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <a asp-controller="Cliente" asp-action="Index" class="btn btn-outline-primary w-100 py-3 rounded-3">
                <i class="bi bi-people me-2"></i>Gerenciar Clientes
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Pacote" asp-action="Index" class="btn btn-outline-warning w-100 py-3 rounded-3">
                <i class="bi bi-box-seam me-2"></i>Gerenciar Pacotes
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Rota" asp-action="Create" class="btn btn-outline-success w-100 py-3 rounded-3">
                <i class="bi bi-geo-alt me-2"></i>Iniciar Nova Rota
            </a>
        </div>
    </div>
</div>
