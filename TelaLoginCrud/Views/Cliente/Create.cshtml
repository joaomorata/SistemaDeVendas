@model TelaLoginCrud.Models.Cliente

@{
    ViewData["Title"] = "Novo Cliente";
}

<div class="container my-4" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-primary text-white py-3 rounded-top">
            <h4 class="mb-0 fw-bold fs-5"><i class="bi bi-person-plus-fill me-2"></i>Cadastrar Cliente</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label fw-semibold"></label>
                    <input asp-for="Nome" class="form-control" placeholder="Ex: Maria Souza" />
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Telefone" class="form-label fw-semibold"></label>
                    <input asp-for="Telefone" class="form-control" placeholder="(00) 00000-0000" />
                    <span asp-validation-for="Telefone" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Endereco" class="form-label fw-semibold"></label>
                    <input asp-for="Endereco" class="form-control" placeholder="Rua e número" />
                    <span asp-validation-for="Endereco" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Bairro" class="form-label fw-semibold"></label>
                        <input asp-for="Bairro" class="form-control" />
                        <span asp-validation-for="Bairro" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Cep" class="form-label fw-semibold"></label>
                        <input asp-for="Cep" class="form-control" placeholder="00000-000" />
                        <span asp-validation-for="Cep" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Cidade" class="form-label fw-semibold"></label>
                    <input asp-for="Cidade" class="form-control" placeholder="Ex: Curitiba" />
                    <span asp-validation-for="Cidade" class="text-danger small"></span>
                </div>

                <div class="alert alert-light border small text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    As coordenadas do cliente são buscadas automaticamente a partir do endereço.
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i> Voltar
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-check-lg me-1"></i> Salvar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
