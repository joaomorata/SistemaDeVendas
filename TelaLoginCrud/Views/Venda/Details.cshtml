@model TelaLoginCrud.Models.Venda

@{
    ViewData["Title"] = "Detalhes da Venda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-info text-white py-3">
            <h4 class="mb-0 fw-bold fs-5"><i class="bi bi-info-circle-fill me-2"></i>Detalhes da Venda</h4>
        </div>
        <div class="card-body p-4">
            <ul class="list-group list-group-flush mb-4">
                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                    <span class="text-muted fw-semibold"><i class="bi bi-box-seam me-2"></i>Produto:</span>
                    <span class="fw-bold fs-6 text-dark">@Model.NomeProd</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                    <span class="text-muted fw-semibold"><i class="bi bi-123 me-2"></i>Quantidade:</span>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fs-6">@Model.Quant un</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                    <span class="text-muted fw-semibold"><i class="bi bi-currency-dollar me-2"></i>Preço Unitário:</span>
                    <span class="fw-bold text-success fs-6">@Model.Preco.ToString("C")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                    <span class="text-muted fw-semibold"><i class="bi bi-calculator me-2"></i>Valor Total da Venda:</span>
                    <span class="fw-bold text-primary fs-5">@((Model.Quant * Model.Preco).ToString("C"))</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                    <span class="text-muted fw-semibold"><i class="bi bi-calendar3 me-2"></i>Data da Venda:</span>
                    <span class="text-dark">@Model.DataVenda.ToString("dd/MM/yyyy")</span>
                </li>
            </ul>

            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Voltar
                </a>
                <a asp-action="Edit" asp-route-id="@Model.IdVenda" class="btn btn-warning rounded-pill px-4 fw-semibold">
                    <i class="bi bi-pencil-square me-1"></i> Editar
                </a>
            </div>
        </div>
    </div>
</div>