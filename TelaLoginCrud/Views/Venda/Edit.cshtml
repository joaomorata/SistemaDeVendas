@model TelaLoginCrud.Models.Venda

@{
    ViewData["Title"] = "Editar Venda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-warning text-dark py-3 rounded-top">
            <h4 class="mb-0 fw-bold fs-5"><i class="bi bi-pencil-square me-2"></i>Editar Venda</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="IdVenda" />

                <div class="mb-3">
                    <label asp-for="NomeProd" class="form-label fw-semibold">Nome do Produto</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-box-seam"></i></span>
                        <input asp-for="NomeProd" class="form-control" />
                    </div>
                    <span asp-validation-for="NomeProd" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Quant" class="form-label fw-semibold">Quantidade</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-123"></i></span>
                        <input asp-for="Quant" class="form-control" type="number" />
                    </div>
                    <span asp-validation-for="Quant" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Preco" class="form-label fw-semibold">Preço Unitário (R$)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-currency-dollar"></i></span>
                        <input asp-for="Preco" class="form-control" step="0.01" />
                    </div>
                    <span asp-validation-for="Preco" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="DataVenda" class="form-label fw-semibold">Data da Venda</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span>
                        <input asp-for="DataVenda" class="form-control" type="date" />
                    </div>
                    <span asp-validation-for="DataVenda" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i> Voltar
                    </a>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i> Atualizar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}