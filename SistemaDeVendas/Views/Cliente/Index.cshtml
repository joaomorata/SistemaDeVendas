@model IEnumerable<SistemaDeVendas.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="container my-4">
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">@TempData["Erro"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="h2 text-primary fw-bold mb-1">
                <i class="bi bi-people-fill me-2"></i>Clientes
            </h1>
            <p class="text-muted small mb-0">Cadastro de clientes e pontos de coleta.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4 py-2">
            <i class="bi bi-person-plus-fill me-1"></i> Novo Cliente
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark text-uppercase small">
                        <tr>
                            <th class="ps-4">Nome</th>
                            <th>Endereço</th>
                            <th>Cidade</th>
                            <th class="text-center">Localização</th>
                            <th class="text-center pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@item.Nome</td>
                                    <td class="text-muted">
                                        @item.Endereco@(string.IsNullOrWhiteSpace(item.Bairro) ? "" : " - " + item.Bairro)
                                    </td>
                                    <td>@item.Cidade</td>
                                    <td class="text-center">
                                        @if (item.Latitude != null && item.Longitude != null)
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2">
                                                <i class="bi bi-geo-alt-fill me-1"></i>Localizado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill px-3 py-2">
                                                <i class="bi bi-geo-alt me-1"></i>Sem coordenadas
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Editar"><i class="bi bi-pencil-square"></i></a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Detalhes"><i class="bi bi-eye"></i></a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Excluir"><i class="bi bi-trash"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    Nenhum cliente cadastrado.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
