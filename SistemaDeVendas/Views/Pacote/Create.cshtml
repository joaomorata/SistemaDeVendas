@model SistemaDeVendas.Models.Pacote

@{
    ViewData["Title"] = "Novo Pacote";
}

<div class="container my-4" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-primary text-white py-3 rounded-top">
            <h4 class="mb-0 fw-bold fs-5"><i class="bi bi-box-seam me-2"></i>Cadastrar Pacote</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ClienteId" class="form-label fw-semibold">Cliente</label>
                    <select asp-for="ClienteId" asp-items="ViewBag.Clientes" class="form-select">
                        <option value="">Selecione um cliente</option>
                    </select>
                    <span asp-validation-for="ClienteId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label fw-semibold"></label>
                    <input asp-for="Descricao" class="form-control" placeholder="Ex: Caixa média" />
                    <span asp-validation-for="Descricao" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Peso" class="form-label fw-semibold"></label>
                    <input asp-for="Peso" class="form-control" step="0.01" placeholder="0,00" />
                    <span asp-validation-for="Peso" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="Coletado" class="form-check-input" />
                    <label asp-for="Coletado" class="form-check-label">Já coletado</label>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i> Voltar
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-check-lg me-1"></i> Salvar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
