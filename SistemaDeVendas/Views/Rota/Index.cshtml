@model IEnumerable<SistemaDeVendas.Models.Rota>

@{
    ViewData["Title"] = "Rotas";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="h2 text-primary fw-bold mb-1">
                <i class="bi bi-signpost-split-fill me-2"></i>Rotas
            </h1>
            <p class="text-muted small mb-0">Rotas de coleta geradas a partir dos clientes.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4 py-2">
            <i class="bi bi-geo-alt-fill me-1"></i> Nova Rota
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark text-uppercase small">
                        <tr>
                            <th class="ps-4">Rota</th>
                            <th class="text-center">Paradas</th>
                            <th class="text-center">Distância</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Criada em</th>
                            <th class="text-center pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@item.Nome</td>
                                    <td class="text-center">@item.Paradas.Count</td>
                                    <td class="text-center">@item.DistanciaKm.ToString("0.0") km</td>
                                    <td class="text-center">
                                        @switch (item.Status)
                                        {
                                            case SistemaDeVendas.Models.StatusRota.Planejada:
                                                <span class="badge bg-secondary rounded-pill px-3 py-2">Planejada</span>
                                                break;
                                            case SistemaDeVendas.Models.StatusRota.EmAndamento:
                                                <span class="badge bg-primary rounded-pill px-3 py-2">Em andamento</span>
                                                break;
                                            default:
                                                <span class="badge bg-success rounded-pill px-3 py-2">Concluída</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center text-muted">@item.DataCriacao.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Abrir"><i class="bi bi-map"></i></a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Excluir"><i class="bi bi-trash"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    Nenhuma rota criada.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
