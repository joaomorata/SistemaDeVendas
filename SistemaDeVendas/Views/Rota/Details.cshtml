@model SistemaDeVendas.Models.Rota

@{
    ViewData["Title"] = "Rota";

    var pontos = new List<object>
    {
        new { lat = Model.LatitudePartida, lng = Model.LongitudePartida, nome = "Partida", ordem = 0 }
    };

    foreach (var parada in Model.Paradas.OrderBy(p => p.Ordem))
    {
        pontos.Add(new
        {
            lat = parada.Cliente?.Latitude,
            lng = parada.Cliente?.Longitude,
            nome = parada.Cliente?.Nome,
            ordem = parada.Ordem
        });
    }
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="h3 text-primary fw-bold mb-1">@Model.Nome</h1>
            <p class="text-muted small mb-0">
                Partida: @Model.EnderecoPartida &nbsp;|&nbsp;
                @Model.Paradas.Count paradas &nbsp;|&nbsp;
                @Model.DistanciaKm.ToString("0.0") km estimados
            </p>
        </div>
        <div class="d-flex gap-2">
            @if (Model.Status == SistemaDeVendas.Models.StatusRota.Planejada)
            {
                <form asp-action="Iniciar" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-play-fill me-1"></i> Iniciar rota
                    </button>
                </form>
            }
            else if (Model.Status == SistemaDeVendas.Models.StatusRota.EmAndamento)
            {
                <span class="badge bg-primary rounded-pill px-3 py-2 align-self-center">Em andamento</span>
            }
            else
            {
                <span class="badge bg-success rounded-pill px-3 py-2 align-self-center">Concluída</span>
            }
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Voltar
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex align-items-center gap-3 py-3">
                            <span class="badge bg-dark rounded-circle" style="width: 28px; height: 28px; line-height: 20px;">
                                <i class="bi bi-flag-fill"></i>
                            </span>
                            <div>
                                <div class="fw-semibold">Ponto de partida</div>
                                <div class="text-muted small">@Model.EnderecoPartida</div>
                            </div>
                        </li>
                        @foreach (var parada in Model.Paradas.OrderBy(p => p.Ordem))
                        {
                            <li class="list-group-item d-flex align-items-center gap-3 py-3">
                                <span class="badge bg-primary rounded-circle" style="width: 28px; height: 28px; line-height: 20px;">
                                    @parada.Ordem
                                </span>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@parada.Cliente?.Nome</div>
                                    <div class="text-muted small">@parada.Cliente?.Endereco, @parada.Cliente?.Cidade</div>
                                </div>
                                @if (parada.Visitada)
                                {
                                    <span class="badge bg-success rounded-pill">Coletado</span>
                                }
                                else if (Model.Status == SistemaDeVendas.Models.StatusRota.EmAndamento)
                                {
                                    <form asp-action="RegistrarColeta" asp-route-id="@parada.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill">
                                            <i class="bi bi-check-lg"></i> Coletar
                                        </button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div id="mapa" style="height: 460px;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var pontos = @Json.Serialize(pontos);

        var mapa = L.map('mapa');
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap'
        }).addTo(mapa);

        var coordenadas = [];

        pontos.forEach(function (p) {
            if (p.lat == null || p.lng == null) {
                return;
            }
            coordenadas.push([p.lat, p.lng]);
            var texto = p.ordem === 0 ? 'Partida' : (p.ordem + '. ' + p.nome);
            L.marker([p.lat, p.lng]).addTo(mapa).bindPopup(texto);
        });

        if (coordenadas.length > 0) {
            L.polyline(coordenadas, { color: '#0d6efd' }).addTo(mapa);
            mapa.fitBounds(coordenadas, { padding: [30, 30] });
        } else {
            mapa.setView([-14.235, -51.925], 4);
        }
    </script>
}
